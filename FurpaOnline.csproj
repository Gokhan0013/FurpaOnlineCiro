<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FurpaOnline</RootNamespace>
    <AssemblyName>FurpaOnline</AssemblyName>
    <Version>0.1.0</Version>
    <Product>FURPA Online</Product>
    <Company>FURPA Bilgi Teknolojileri</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paketleme çıktısı (publish klasörü) projeye dahil edilmesin -->
    <Compile Remove="publish\**" />
    <Content Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gerçek bağlantı bilgileri bu dosyada durur; yayına/git'e gitmez -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <Content Update="regions.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
